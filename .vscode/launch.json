{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "تشغيل SAS RADIUS Web",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/SAS-4.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "OPEN_BROWSER": "1",
        "WEB_PORT": "8000"
      },
      "serverReadyAction": {
        "pattern": "Uvicorn running on (https?://\\S+)",
        "uriFormat": "http://127.0.0.1:8000/",
        "action": "openExternally"
      }
    }
  ]
}
